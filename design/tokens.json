{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Fuente única de tokens de diseño. Extraídos del prototipo de Claude Design (design/prototype/Main.dc.html) el 2026-09-24. Formato W3C Design Tokens (DTCG). El código se genera a partir de este archivo; no se editan valores en el código.",
  "color": {
    "$type": "color",
    "ink": { "$value": "#111111", "$description": "Tinta: texto, bordes, sombras duras y rellenos de mantener pulsado" },
    "paper": { "$value": "#F4F1EA", "$description": "Fondo de la app (papel)" },
    "line": { "$value": "#D8D4CA", "$description": "Líneas y separadores" },
    "selection": { "$value": "rgba(17, 17, 17, 0.2)", "$description": "Fondo del texto seleccionado (ink al 20 %)" },
    "surface": { "$value": "#FFFFFF", "$description": "Botones, hojas inferiores y fondo tras adjuntos" },
    "textMuted": { "$value": "#55534E", "$description": "Texto secundario (Space Mono)" },
    "disabled": { "$value": "#C7C4BF", "$description": "Elementos deshabilitados, sin contenido esencial" },
    "error": { "$value": "#B3241A", "$description": "Texto de error (p. ej. URL no válida)" },
    "dangerFill": { "$value": "#FF5A4E", "$description": "Relleno del botón Eliminar; el texto es ink" },
    "paperFiber": { "$value": "#FFFDF3", "$description": "Fibra del papel roto al completar" },
    "onInk": { "$value": "#FFFFFF", "$description": "Texto sobre ink (etiquetas, pantalla de enhorabuena)" },
    "scrim": { "$value": "rgba(17, 17, 17, 0.55)", "$description": "Velo bajo las hojas inferiores" },
    "placeholder": { "$value": "rgba(17, 17, 17, 0.66)", "$description": "Placeholder del editor. El prototipo usa 0.42 (contraste 2.5:1, falla AA); se sube a 0.66 (>= 4.59:1 en todas las notas). Ver docs/design/prototype-deviations.md" },
    "pressed": { "$value": "rgba(17, 17, 17, 0.06)", "$description": "Fondo de una fila de menú pulsada" }
  },
  "palette": {
    "$type": "color",
    "$description": "Colores de nota adhesiva. El índice (colorKey 0–4) se guarda con la tarea; la paleta activa decide el valor. Una tarea nueva nunca repite el color de la tarea actual.",
    "classic": {
      "0": { "$value": "#FFE55C", "$description": "Amarillo" },
      "1": { "$value": "#FF9EC4", "$description": "Rosa" },
      "2": { "$value": "#8FD3F4", "$description": "Azul" },
      "3": { "$value": "#A6E88F", "$description": "Verde" },
      "4": { "$value": "#FFB870", "$description": "Naranja" }
    },
    "neon": {
      "$description": "Variante del prototipo. Futuro theming (Bloque 4); tras un feature flag.",
      "0": { "$value": "#F4FF3A" },
      "1": { "$value": "#FF6FAE" },
      "2": { "$value": "#45E0FF" },
      "3": { "$value": "#63FF84" },
      "4": { "$value": "#FF9D3F" }
    },
    "mono": {
      "$description": "Variante 'amarillo' del prototipo: todas las notas amarillas. Futuro theming.",
      "0": { "$value": "#FFE55C" },
      "1": { "$value": "#FFE55C" },
      "2": { "$value": "#FFE55C" },
      "3": { "$value": "#FFE55C" },
      "4": { "$value": "#FFE55C" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["Archivo", "system-ui", "sans-serif"], "$description": "Títulos, texto de tarea, botones. Pesos 500–900. Licencia OFL; se empaqueta en la app (nunca desde la red)." },
      "mono": { "$value": ["Space Mono", "ui-monospace", "monospace"], "$description": "Textos secundarios, etiquetas y ayudas. Pesos 400 y 700. OFL; empaquetada." }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 },
      "black": { "$value": 900 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Tamaños lógicos (pt/dp) a escala 1.0; se multiplican por el textScaler del sistema.",
      "noteXL": { "$value": { "value": 50, "unit": "px" }, "$description": "Texto de tarea < 40 caracteres" },
      "noteL": { "$value": { "value": 40, "unit": "px" }, "$description": "40–89 caracteres" },
      "noteM": { "$value": { "value": 31, "unit": "px" }, "$description": "90–159 caracteres" },
      "noteS": { "$value": { "value": 26, "unit": "px" }, "$description": ">= 160 caracteres" },
      "hero": { "$value": { "value": 56, "unit": "px" }, "$description": "Estados vacíos (Todo hecho.)" },
      "intro": { "$value": { "value": 52, "unit": "px" }, "$description": "Texto de la bienvenida" },
      "display": { "$value": { "value": 34, "unit": "px" } },
      "title": { "$value": { "value": 26, "unit": "px" } },
      "heading": { "$value": { "value": 22, "unit": "px" } },
      "button": { "$value": { "value": 20, "unit": "px" }, "$description": "Botón de completar" },
      "bodyL": { "$value": { "value": 19, "unit": "px" }, "$description": "Filas de menú y botones" },
      "body": { "$value": { "value": 17, "unit": "px" } },
      "bodyS": { "$value": { "value": 15, "unit": "px" } },
      "caption": { "$value": { "value": 13, "unit": "px" } },
      "tag": { "$value": { "value": 12, "unit": "px" } },
      "micro": { "$value": { "value": 11, "unit": "px" } }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tightest": { "$value": { "value": -0.04, "unit": "em" } },
      "intro": { "$value": { "value": -0.035, "unit": "em" }, "$description": "Texto de la bienvenida" },
      "tighter": { "$value": { "value": -0.03, "unit": "em" } },
      "tight": { "$value": { "value": -0.02, "unit": "em" } },
      "snug": { "$value": { "value": -0.01, "unit": "em" } },
      "tagWide": { "$value": { "value": 0.08, "unit": "em" } }
    },
    "noteLengthBreakpoints": {
      "$description": "Límites de caracteres para elegir noteXL/L/M/S",
      "$value": [40, 90, 160]
    }
  },
  "space": {
    "$type": "dimension",
    "xxs": { "$value": { "value": 2, "unit": "px" } },
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "s": { "$value": { "value": 8, "unit": "px" } },
    "sm": { "$value": { "value": 12, "unit": "px" } },
    "m": { "$value": { "value": 16, "unit": "px" } },
    "ml": { "$value": { "value": 20, "unit": "px" } },
    "l": { "$value": { "value": 24, "unit": "px" }, "$description": "Margen lateral de pantalla" },
    "xl": { "$value": { "value": 28, "unit": "px" } },
    "xxl": { "$value": { "value": 40, "unit": "px" } }
  },
  "size": {
    "$type": "dimension",
    "minTouchTarget": { "$value": { "value": 44, "unit": "px" }, "$description": "Objetivo táctil mínimo (Android usa 48 dp)" },
    "frameWidth": { "$value": { "value": 390, "unit": "px" }, "$description": "Ancho de referencia del prototipo" },
    "frameHeight": { "$value": { "value": 844, "unit": "px" } },
    "contentMaxWidth": { "$value": { "value": 600, "unit": "px" }, "$description": "Ancho máximo del contenido en tablets y plegables; se centra (CL-001-7)" },
    "icon": { "$value": { "value": 22, "unit": "px" }, "$description": "Iconos de barra (menú, volver)" },
    "iconM": { "$value": { "value": 24, "unit": "px" }, "$description": "Flecha de Guardar" },
    "iconL": { "$value": { "value": 26, "unit": "px" }, "$description": "Iconos de los botones grandes (+, completar)" },
    "iconStroke": { "$value": { "value": 2.4, "unit": "px" }, "$description": "Trazo de los iconos (.ic del prototipo)" },
    "iconStrokeBold": { "$value": { "value": 3, "unit": "px" }, "$description": "Trazo de los iconos de los botones grandes" },
    "iconButton": { "$value": { "value": 46, "unit": "px" }, "$description": "Botón cuadrado de barra (menú); zona táctil de 48 en Android" },
    "button": { "$value": { "value": 64, "unit": "px" }, "$description": "Alto de los botones grandes (.bb: Guardar, +)" },
    "holdButton": { "$value": { "value": 72, "unit": "px" }, "$description": "Alto del botón de completar" },
    "caretWidth": { "$value": { "value": 6, "unit": "px" }, "$description": "Cursor de bloque de la bienvenida (alto: 0,8 em)" }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "strong": { "$value": { "value": 3, "unit": "px" }, "$description": "Bordes de botones, notas y hojas" },
      "focus": { "$value": { "value": 3, "unit": "px" }, "$description": "Anillo de foco, desplazado 3 px" }
    },
    "radius": {
      "$type": "dimension",
      "none": { "$value": { "value": 0, "unit": "px" }, "$description": "Estética brutalista: sin esquinas redondeadas" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "button": { "$value": { "color": "#111111", "offsetX": { "value": 5, "unit": "px" }, "offsetY": { "value": 5, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "buttonPressed": { "$value": { "color": "#111111", "offsetX": { "value": 1, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }, "$description": "Además se desplaza 4,4 px" },
    "iconButton": { "$value": { "color": "#111111", "offsetX": { "value": 3, "unit": "px" }, "offsetY": { "value": 3, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "listItem": { "$value": { "color": "#111111", "offsetX": { "value": 4, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "listItemDragging": { "$value": { "color": "#111111", "offsetX": { "value": 10, "unit": "px" }, "offsetY": { "value": 10, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } },
    "listItemFlash": { "$value": { "color": "#111111", "offsetX": { "value": 9, "unit": "px" }, "offsetY": { "value": 9, "unit": "px" }, "blur": { "value": 0, "unit": "px" }, "spread": { "value": 0, "unit": "px" } } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "press": { "$value": { "value": 80, "unit": "ms" } },
      "sheetIn": { "$value": { "value": 200, "unit": "ms" } },
      "sheetOut": { "$value": { "value": 160, "unit": "ms" } },
      "enter": { "$value": { "value": 450, "unit": "ms" } },
      "holdToComplete": { "$value": { "value": 1200, "unit": "ms" }, "$description": "Tiempo de mantener pulsado para completar" },
      "holdRelease": { "$value": { "value": 280, "unit": "ms" }, "$description": "Retroceso del relleno al soltar antes de tiempo" },
      "tear": { "$value": { "value": 1250, "unit": "ms" }, "$description": "La nota se rompe en dos" },
      "successHold": { "$value": { "value": 2100, "unit": "ms" }, "$description": "Tiempo visible de ¡Enhorabuena!" },
      "successFade": { "$value": { "value": 700, "unit": "ms" } },
      "crumple": { "$value": { "value": 2200, "unit": "ms" }, "$description": "Arrugar y tirar a la papelera" },
      "introCharStep": { "$value": { "value": 62, "unit": "ms" }, "$description": "Máquina de escribir de la bienvenida" },
      "caretBlink": { "$value": { "value": 1000, "unit": "ms" }, "$description": "Parpadeo del cursor de la bienvenida (steps(1))" },
      "introFade": { "$value": { "value": 800, "unit": "ms" } },
      "listFlash": { "$value": { "value": 900, "unit": "ms" } },
      "doubleTapWindow": { "$value": { "value": 350, "unit": "ms" } },
      "undoWindow": { "$value": { "value": 6000, "unit": "ms" }, "$description": "Ventana para deshacer una eliminación (ADR-0006)" },
      "reducedMotionFade": { "$value": { "value": 400, "unit": "ms" }, "$description": "Sustituto con 'reducir movimiento'" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2, 0.8, 0.2, 1] },
      "sheet": { "$value": [0.2, 0.9, 0.3, 1] },
      "sheetOut": { "$value": [0.5, 0, 0.8, 0.4] },
      "tear": { "$value": [0.3, 0, 0.2, 1] },
      "fall": { "$value": [0.55, 0, 1, 0.45] },
      "stamp": { "$value": [0.2, 1.6, 0.4, 1] }
    },
    "dragThreshold": { "$type": "dimension", "$value": { "value": 6, "unit": "px" } }
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9–11 (ADR-0004, CA-008-17): BD y preferencias, sin adjuntos (imágenes ni PDF),
     y solo si la copia va cifrada de extremo a extremo (el móvil tiene bloqueo de pantalla). -->
<full-backup-content>
    <include domain="root" path="app_flutter/" requireFlags="clientSideEncryption"/>
    <include domain="sharedpref" path="." requireFlags="clientSideEncryption"/>
    <!-- Las preferencias de la WebView de la tarea web, no (CA-009-13). -->
    <exclude domain="sharedpref" path="AwOriginVisitLoggerPrefs.xml"/>
    <exclude domain="sharedpref" path="WebViewChromiumPrefs.xml"/>
</full-backup-content>

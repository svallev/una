<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (ADR-0004). BD (app_flutter/) y preferencias. Los adjuntos llegarán en F4
     con un BackupAgent con presupuesto (la cuota de 25 MB descarta toda la copia, spike S5).
     La copia en la nube solo se hace si va cifrada de extremo a extremo (bloqueo de pantalla). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="root" path="app_flutter/"/>
        <include domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/"/>
        <include domain="sharedpref" path="."/>
        <include domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>

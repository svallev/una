<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.x (ADR-0004): no hay cifrado de extremo a extremo de la copia, así que no se
     copia nada. Android 9–11 usa xml-v28/backup_rules.xml; Android 12+, data_extraction_rules. -->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>

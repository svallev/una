  "fixed_sql": [
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"body\" TEXT NULL, \"status\" TEXT NOT NULL, \"rank\" TEXT NOT NULL, \"color_key\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"completed_at\" INTEGER NULL, \"deleted_at\" INTEGER NULL, \"due_date\" INTEGER NULL, \"parent_id\" TEXT NULL REFERENCES tasks (id), \"source\" TEXT NOT NULL DEFAULT 'local', \"external_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attachments\" (\"id\" TEXT NOT NULL, \"task_id\" TEXT NOT NULL REFERENCES tasks (id), \"kind\" TEXT NOT NULL, \"origin\" TEXT NOT NULL, \"mime\" TEXT NOT NULL, \"byte_size\" INTEGER NOT NULL, \"rel_path\" TEXT NOT NULL, \"display_rel_path\" TEXT NULL, \"thumb_rel_path\" TEXT NULL, \"original_name\" TEXT NULL, \"source_url\" TEXT NULL, \"source_host\" TEXT NULL, \"snapshot_rel_path\" TEXT NULL, \"snapshot_at\" INTEGER NULL, \"width\" INTEGER NULL, \"height\" INTEGER NULL, \"page_count\" INTEGER NULL, \"sha256\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
